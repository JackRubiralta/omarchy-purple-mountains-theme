{
  "manifest_version": 2,
  "name": "Purple Mountains Theme",
  "version": "1.1.0",
  "description": "Firefox theme for the Purple Mountains Omarchy theme.",
  "author": "Jack Rubiralta",
  "browser_specific_settings": {
    "gecko": {
      "id": "purple-mountains-theme@local",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#0d0d0d",
      "frame_inactive": "#0d0d0d",
      "tab_background_text": "#f4f1f1",
      "tab_text": "#f4f1f1",
      "tab_line": "#6c77ea",
      "tab_loading": "#6c77ea",
      "tab_selected": "#141414",
      "toolbar": "#0d0d0d",
      "toolbar_text": "#f4f1f1",
      "toolbar_field": "#141414",
      "toolbar_field_text": "#f4f1f1",
      "toolbar_field_border": "#1c1c1c",
      "toolbar_field_focus": "#141414",
      "toolbar_field_text_focus": "#f4f1f1",
      "toolbar_field_border_focus": "#6c77ea",
      "toolbar_field_highlight": "rgba(108, 119, 234, 0.3)",
      "toolbar_field_highlight_text": "#f4f1f1",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "transparent",
      "toolbar_vertical_separator": "rgba(140, 138, 157, 0.2)",
      "bookmark_text": "#8c8a9d",
      "icons": "#8c8a9d",
      "icons_attention": "#6c77ea",
      "button_background_hover": "rgba(108, 119, 234, 0.12)",
      "button_background_active": "rgba(108, 119, 234, 0.22)",
      "popup": "#0d0d0d",
      "popup_text": "#f4f1f1",
      "popup_border": "#1c1c1c",
      "popup_highlight": "#6c77ea",
      "popup_highlight_text": "#f4f1f1",
      "sidebar": "#0d0d0d",
      "sidebar_text": "#f4f1f1",
      "sidebar_border": "#1c1c1c",
      "sidebar_highlight": "#6c77ea",
      "sidebar_highlight_text": "#f4f1f1",
      "ntp_background": "#0d0d0d",
      "ntp_text": "#f4f1f1",
      "ntp_card_background": "#141414"
    },
    "properties": {
      "color_scheme": "dark"
    }
  }
}
